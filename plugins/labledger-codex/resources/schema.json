{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "task",
                "decision",
                "experiment",
                "run",
                "finding",
                "claim",
                "probe",
                "exposure",
                "review"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "id",
            "revision"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "artifact",
                "source",
                "document"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "checksum": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "availability": {
              "enum": [
                "available",
                "external",
                "unavailable"
              ]
            },
            "access_requirements": {
              "type": "string"
            },
            "visibility": {
              "enum": [
                "development",
                "restricted_evaluation"
              ]
            }
          },
          "required": [
            "type"
          ],
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "uri"
              ]
            }
          ]
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "source"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "entity_type": {
          "const": "task"
        },
        "id": {
          "type": "string",
          "pattern": "^TASK-[a-f0-9]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "development",
            "restricted_evaluation"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "brainstorming",
            "ready_for_planning",
            "planning",
            "plan_approved",
            "implementing",
            "evaluating",
            "completed",
            "blocked",
            "paused",
            "cancelled"
          ]
        },
        "brief_revision": {
          "type": "integer",
          "minimum": 0
        },
        "plan_revision": {
          "type": "integer",
          "minimum": 0
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "approval_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "summary",
            "source"
          ]
        },
        "handoff": {
          "type": "object"
        },
        "plan": {
          "type": "object"
        },
        "blocker_reason": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "planning_evidence": {
          "$ref": "#/$defs/approval"
        }
      },
      "required": [
        "created_at",
        "id",
        "visibility",
        "updated_at",
        "revision",
        "entity_type",
        "schema_version",
        "title",
        "status",
        "brief_revision",
        "plan_revision",
        "decision_refs",
        "acceptance_criteria"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "entity_type": {
          "const": "decision"
        },
        "id": {
          "type": "string",
          "pattern": "^DEC-[a-f0-9]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "development",
            "restricted_evaluation"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "approved_scope": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "selected_option": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "discussed",
            "approved",
            "rejected",
            "deferred",
            "superseded"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "approval_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "summary",
            "source"
          ]
        },
        "revisit_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "created_at",
        "id",
        "visibility",
        "updated_at",
        "revision",
        "entity_type",
        "schema_version",
        "question",
        "options",
        "status",
        "evidence_refs"
      ]
    },
    "experiment": {

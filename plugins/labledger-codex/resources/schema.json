        "dataset_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "development",
                  "validation",
                  "held_out_test"
                ]
              }
            },
            "required": [
              "id",
              "version",
              "role",
              "provenance"
            ],
            "additionalProperties": false
          }
        },
        "primary_metric": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "denominator": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": [
                "higher",
                "lower"
              ]
            }
          },
          "required": [
            "name",
            "direction",
            "unit",
            "denominator"
          ],
          "additionalProperties": false
        },
        "secondary_metrics": {
          "type": "array",

            "type": "object"
          }
        },
        "repetitions": {
          "type": "object"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_runs": {
              "type": "integer",
              "minimum": 1
            },
            "wall_time_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "cost": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "running",
            "closed",
            "superseded"
          ]
        },
        "approval_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "summary",
            "source"
          ]
        },
        "approved_scope": {
          "type": "string",
          "minLength": 1
        },
        "observed_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "revision_reason": {
          "type": "string",
          "minLength": 1
        },
        "freeze": {
          "type": "object"
        }
      },
      "required": [
        "created_at",
        "id",
        "visibility",
        "updated_at",
        "revision",
        "entity_type",
        "schema_version",
        "hypothesis",
        "status",
        "decision_refs"
      ]
    },
